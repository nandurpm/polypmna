# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex HTTP-actions origin used as the token issuer. Convex normally supplies it.
CONVEX_SITE_URL=

# Frontend origin used by Convex Auth callbacks.
SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Server-only Convex AI provider variables. Never prefix these with VITE_.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_MODELS=cohere/north-mini-code:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
POLY_AI_SITE_URL=https://gptcperinthalmanna.dpdns.org/
POLY_AI_SITE_URL=https://nandurpm.github.io/polypmna/
POLY_AI_NVIDIA_TIMEOUT_MS=10000
POLY_AI_PROVIDER_TIMEOUT_MS=25000
POLY_AI_STREAM_TIMEOUT_MS=90000
POLY_AI_MAX_TOKENS=1600
POLY_AI_PROVIDER_COOLDOWN_MS=60000
POLY_AI_OPENROUTER_RPM_LIMIT=18
POLY_AI_OPENROUTER_DAILY_LIMIT=45

# CI only: production Convex deploy key used by GitHub Actions.
CONVEX_DEPLOY_KEY=
