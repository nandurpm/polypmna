# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Server-only Convex AI provider variables. Never prefix these with VITE_.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
POLY_AI_SITE_URL=https://nandurpm.github.io/polypmna/

# CI only: production Convex deploy key used by GitHub Actions.
CONVEX_DEPLOY_KEY=
